{
  "name": "cw-practice",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "CW (Morse) straight-key practice trainer with adaptive timing recognition",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:nodeps": "node scripts/build.mjs",
    "preview": "vite preview",
    "test": "node --experimental-strip-types tests/core.test.ts",
    "test:watch": "node --watch --experimental-strip-types tests/core.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.4",
    "@types/node": "^22.9.0"
  }
}
